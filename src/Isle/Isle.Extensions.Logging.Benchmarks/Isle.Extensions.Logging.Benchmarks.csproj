<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>LatestMajor</LangVersion>
    <Copyright>© Pavel Fedarovich, 2022-$([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.16.0-preview.2" />
    <PackageReference Include="Serilog" Version="3.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="3.1.0" />
    <PackageReference Include="System.Collections.Immutable" Version="11.0.0" />
    <PackageReference Include="System.Reflection.Metadata" Version="11.0.0" />
  </ItemGroup>

  <!--
    BenchmarkDotNet 0.16 transitively requires Microsoft.Extensions.Logging.Abstractions >= 10.0.3 on all TFMs
    (via Microsoft.Diagnostics.Runtime -> Azure.Core). Since MEL 10, ILoggingBuilder and ProviderAliasAttribute
    live in Logging.Abstractions, so Microsoft.Extensions.Logging must not be older than 10.x here (CS0433 otherwise).
  -->
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Isle.Extensions.Logging\Isle.Extensions.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Isle.Core.Analyzers\Isle.Core.Analyzers.csproj" ReferenceOutputAssembly="False" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>

</Project>
