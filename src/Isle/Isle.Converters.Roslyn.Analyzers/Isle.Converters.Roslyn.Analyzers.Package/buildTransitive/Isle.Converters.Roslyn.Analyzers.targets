<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="IsleRoslynNameConverterRemoveMethodPrefixes" />
    <CompilerVisibleProperty Include="IsleRoslynNameConverterRemoveMethodPrefixesStringComparison" />
  </ItemGroup>
  <Target Name="ReplaceSeparatorsInIsleRoslynNameConverterRemoveMethodPrefixes"
          BeforeTargets="GenerateMSBuildEditorConfigFileCore;BeforeCompile"
          Condition=" '$(IsleRoslynNameConverterRemoveMethodPrefixes)' != '' ">
    <PropertyGroup>
      <IsleRoslynNameConverterRemoveMethodPrefixes>$([System.Text.RegularExpressions.Regex]::Replace('$(IsleRoslynNameConverterRemoveMethodPrefixes)', '[;\r\n]', ' '))</IsleRoslynNameConverterRemoveMethodPrefixes>
    </PropertyGroup>
  </Target>
</Project>